# Local port
APP_PORT=3000
APP_NODE_ENV=production
AUTH_MODE=google
DEV_AUTH_OPEN_ID=
DEV_SERVE_STATIC=false

# Disposable Docker-only MySQL credentials.
# If these values change, update all four together and URL-encode special
# characters before using them in a DATABASE_URL.
MYSQL_DATABASE=luxe
MYSQL_USER=luxe
MYSQL_PASSWORD=luxe_local_password
MYSQL_ROOT_PASSWORD=luxe_local_root_password

# Required. Generate the canonical 32-byte base64url value documented in README.md.
JWT_SECRET=

# Google OAuth. This exact loopback callback must also be registered in the
# Google OAuth client. Keep local access on 127.0.0.1:3000.
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback
AUTH_ALLOWED_EMAILS=owner@example.com

# Idempotent first-owner bootstrap. LOCAL_OWNER_EMAIL must also appear in
# AUTH_ALLOWED_EMAILS.
LOCAL_OWNER_EMAIL=owner@example.com
LOCAL_ORGANIZATION_NAME=Luxe Local
LOCAL_ORGANIZATION_PHONE=+9633000000
LOCAL_ORGANIZATION_ADDRESS=
LOCAL_ORGANIZATION_CURRENCY=SYP

# Local email delivery is deliberately disabled.
EMAIL_DELIVERY_MODE=disabled

# Optional external integrations.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional observability and analytics.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
