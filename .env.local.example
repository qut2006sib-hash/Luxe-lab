# Loopback-only laptop preview. This mode must never be used for Staging or
# production and is rejected unless NODE_ENV=development and DEPLOYMENT_ENV=local.
APP_PORT=3000
APP_NODE_ENV=development
AUTH_MODE=disabled
DEV_SERVE_STATIC=true

# This value matches the bootstrapped owner@example.com identity below.
# If LOCAL_OWNER_EMAIL changes, use the Google OAuth setup instead or regenerate
# this value as documented in docs/DOCKER.md.
DEV_AUTH_OPEN_ID=local-preseed:c8cd3c6427301eaf6665bccacd65ddb614527acc843a1546

# Disposable Docker-only MySQL credentials.
MYSQL_DATABASE=luxe
MYSQL_USER=luxe
MYSQL_PASSWORD=luxe_local_password
MYSQL_ROOT_PASSWORD=luxe_local_root_password

# Not required while AUTH_MODE=disabled.
JWT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Idempotent local owner and organization bootstrap.
AUTH_ALLOWED_EMAILS=owner@example.com
LOCAL_OWNER_EMAIL=owner@example.com
LOCAL_ORGANIZATION_NAME=Luxe Local
LOCAL_ORGANIZATION_PHONE=+9633000000
LOCAL_ORGANIZATION_ADDRESS=
LOCAL_ORGANIZATION_CURRENCY=SYP

EMAIL_DELIVERY_MODE=disabled

# Optional browser integrations.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
